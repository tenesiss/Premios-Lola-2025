# Copy to .env.local. Keep credentials out of version control.
SQL_URL=mysql://lola:YOUR_PASSWORD@127.0.0.1:3306/premios_lola_local
HOST=127.0.0.1
PORT=8000
FIREBASE_PROJECT_ID=YOUR_FRONTEND_FIREBASE_PROJECT_ID
ADMIN_TOKEN=YOUR_RANDOM_ADMIN_TOKEN
# Optional extra browser origins, separated by commas.
CORS_ORIGINS=
# Optional service account, needed only for additional Firebase Admin operations.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional voting policy settings.
ADMIN_UID=
VOTE_MASTER=
# Comma-separated group IDs allowed to repeat votes (for example: 3,5).
# Leave empty to disable group exceptions. Group 3 has no special treatment.
GROUP_ALLOW_REMOTE=3
RATELIMIT_SECOND=5
