# Docker Compose configuration. Copy this file to .env at the repository root.
FRONTEND_PORT=5173
BACKEND_PORT=8000

MYSQL_DATABASE=premios_lola
MYSQL_USER=lola
# Use a URL-safe password (letters, digits, hyphens, underscores), since the API
# consumes a MySQL URL. A random hex string is suitable; see README.md.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
ADMIN_TOKEN=

# Public Firebase web configuration; the backend uses the same project ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional backend configuration.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ADMIN_UID=
VOTE_MASTER=
GROUP_ALLOW_REMOTE=
RATELIMIT_SECOND=5
# Additional browser origins (including scheme and port), comma-separated.
CORS_ORIGINS=
